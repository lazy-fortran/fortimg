#!/bin/sh
# The JPEG test takes libjpeg-turbo as its reference, opened at run time; the
# runner image has none, so it comes from conda-forge into a prefix kept
# between checks. The library itself needs no C library.
set -eu
version=2.10.0-0
root=${TMPDIR:-/tmp}/fortimg-deps-$version
if [ ! -e "$root/env/lib/libturbojpeg.so.0" ]; then
    mkdir -p "$root"
    curl -fsSL -o "$root/micromamba" \
        "https://github.com/mamba-org/micromamba-releases/releases/download/$version/micromamba-linux-64"
    chmod 755 "$root/micromamba"
    MAMBA_ROOT_PREFIX=$root/mamba "$root/micromamba" create -y -q -p "$root/env" \
        -c conda-forge libjpeg-turbo
fi
export LD_LIBRARY_PATH="$root/env/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fo test "$@"
